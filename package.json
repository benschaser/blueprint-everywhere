{
  "name": "blueprint-everywhere",
  "version": "0.1.0",
  "private": true,
  "description": "Cross-framework design system inspired by Palantir's BlueprintJS — including ports for Vue, Angular, and WPF.",
  "repository": {
    "type": "git",
    "url": "https://github.com/benschaser/blueprint-everywhere"
  },
  "license": "Apache-2.0",
  "author": "Ben Schaser",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "lint": "turbo run lint",
    "clean": "turbo run clean",
    "test": "turbo run test",
    "check": "turbo run typecheck",
    "release": "turbo run build && turbo run publish"
  },
  "devDependencies": {
    "turbo": "^2.0.0",
    "typescript": "^5.6.0",
    "prettier": "^3.3.3"
  },
  "packageManager": "pnpm@10.20.0",
  "pnpm": {
    "overrides": {
      "typescript": "^5.6.0"
    }
  },
  "workspaces": [
    "packages/*"
  ]
}
